# =============================================================================
# NGUỒN SỰ THẬT DUY NHẤT cho toàn bộ stack.
#
# Mọi thành phần đều đọc từ file này, không nơi nào hardcode lại:
#   infra/local/compose.*.yml                            ${VAR}   — docker compose nội suy
#   engine-runners/trino-runner/catalog/*.properties     ${ENV:VAR} — Trino nội suy
#   engine-runners/spark-runner/spark-defaults.conf.tmpl ${VAR}   — entrypoint nội suy lúc khởi động
#   transforms/profiles.yml + dbt_project.yml            {{ env_var('VAR') }} — dbt nội suy
#   ingestion/common/config.py                           os.environ — code Spark
#   Makefile                                             `-include .env` rồi export
#
# Đổi endpoint / bucket / version ở đây là đổi cho TẤT CẢ.
#
# LƯU Ý: Makefile include file này nên chỉ dùng cú pháp KEY=value đơn giản.
# Không dùng dấu nháy, không dùng '#' trong giá trị (Make sẽ hiểu là comment).
#
# Khởi tạo:  cp .env.example .env   rồi đổi mật khẩu.
# =============================================================================

# ---- Phiên bản image / thư viện ---------------------------------------------
ICEBERG_VERSION=1.9.2
POSTGRES_JDBC_VERSION=42.7.4
SPARK_BASE_IMAGE=apache/spark:3.5.6-python3
# pyyaml cho code ingestion trong container Spark (đọc sources.yml)
PYYAML_VERSION=6.0.2
# dbt-core và các adapter đánh version ĐỘC LẬP nhau, nên phải khai riêng.
# Pin chính xác (==) chứ không dùng ~=: build tháng sau phải ra đúng image tháng này.
# Nâng version = đổi ở đây rồi `make duckdb-up` / `make lake-up` (compose tự build lại).
DBT_CORE_VERSION=1.12.0
DBT_DUCKDB_VERSION=1.10.1
DBT_TRINO_VERSION=1.10.3

# ---- MinIO / S3 --------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
# Endpoint nội bộ trong docker network (Spark/Trino/Iceberg dùng tên service này)
S3_ENDPOINT=http://minio:9000
# Cổng mở ra máy host
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# AWS-style creds — Iceberg/Spark/Trino đọc từ đây để nói chuyện với MinIO.
# Phải trùng MINIO_ROOT_USER / MINIO_ROOT_PASSWORD ở trên.
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1

# ---- Iceberg catalog ---------------------------------------------------------
WAREHOUSE_BUCKET=warehouse
ICEBERG_CATALOG_NAME=iceberg
ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_REST_PORT=8181

# Postgres làm metastore cho Iceberg REST catalog (lưu namespace/bảng)
CATALOG_DB_NAME=iceberg
CATALOG_DB_USER=iceberg
CATALOG_DB_PASSWORD=change-me

# ---- Tên tầng dữ liệu (dùng chung Spark + dbt + Trino) -----------------------
# Spark ghi bronze vào <ICEBERG_CATALOG_NAME>.<BRONZE_NAMESPACE>
BRONZE_NAMESPACE=bronze
# dbt build silver/gold vào schema này
ANALYTICS_SCHEMA=analytics

# ---- Trino -------------------------------------------------------------------
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin

# ---- Đường dẫn BÊN TRONG container ------------------------------------------
# Đổi ở đây thì compose, Makefile và code Spark đều đổi theo.
SPARK_DATA_DIR=/opt/spark/data
SPARK_JOBS_DIR=/opt/spark/jobs
# Model bronze của dbt, mount chỉ-đọc vào Spark để chạy chung một bản SQL
SPARK_MODELS_DIR=/opt/spark/transforms/models
DBT_PROJECT_DIR=/usr/app/dbt
DBT_DATA_DIR=/data
DUCKDB_PATH=/warehouse/hdh.duckdb
