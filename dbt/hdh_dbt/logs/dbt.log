    create table "iceberg"."analytics"."gold_orders_daily__dbt_tmp"
      
      
    as (
      -- Gold: số đơn theo ngày.
-- Chưa có revenue vì orders.csv không còn cột tiền — doanh thu nằm ở order_items.csv,
