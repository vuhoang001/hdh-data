-- cú pháp Postgres mà Trino không hỗ trợ.
--
-- Test singular: PASS khi trả về 0 dòng.
with fact as (
    select count(*) as n from "iceberg"."analytics"."fact_order_items"
),

silver as (
    select count(*) as n from "iceberg"."analytics"."silver_order_items"
)

select
    fact.n   as fact_rows,
    silver.n as silver_rows
from fact
cross join silver
where fact.n <> silver.n
  
  
      
    ) dbt_internal_test
