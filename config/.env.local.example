# =============================================================================
# OVERRIDE CÁ NHÂN — copy thành config/.env.local (đã gitignore).
#
#     cp config/.env.local.example config/.env.local
#
# Nạp SAU CÙNG nên mọi giá trị ở đây thắng .env.shared và .env.<ENV>.
# Dùng cho: secret thật, và cấu hình riêng của máy bạn.
# =============================================================================

# ---- Chạy DuckDB NATIVE trên laptop, không qua Docker ------------------------
# Mặc định .env.dev trỏ vào tên service trong docker network (minio, iceberg-rest).
# Chạy thẳng trên máy thì phải trỏ localhost — cổng đã map sẵn ra host.
# MINIO_ENDPOINT=localhost:9000
# ICEBERG_REST_URI=http://localhost:8181
# DUCKDB_PATH=./dev_scratch.duckdb

# ---- Secret thật -------------------------------------------------------------
# MINIO_ROOT_PASSWORD=...
# AWS_SECRET_ACCESS_KEY=...
# CATALOG_DB_PASSWORD=...

# ---- Chạy dev trên dữ liệu đầy đủ thay vì sample -----------------------------
# SAMPLE_ENABLED=false
