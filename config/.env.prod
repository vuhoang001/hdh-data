# =============================================================================
# MÔI TRƯỜNG PRODUCTION — Trino làm execution engine.
#
#   dbt ──► Trino ──► Iceberg ──► MinIO
#
# PROD KHÔNG phụ thuộc DuckDB. Spark chỉ dùng cho ingestion khi cần scale.
#
# Dùng:  make ENV=prod <target>
#
# >>> SECRET <<<
# File này commit được vì chỉ chứa PLACEHOLDER. Ở production thật, KHÔNG sửa file
# này — inject qua secret manager (Docker/K8s secret, Vault, AWS SM). Mọi biến đều
# đọc qua os.environ / ${VAR} nên inject kiểu gì cũng chạy, không phải đổi code.
# =============================================================================

ENVIRONMENT=prod

# ---- Execution engine --------------------------------------------------------
DBT_TARGET=prod
INGESTION_ENGINE=spark

# ---- Namespace theo tầng -----------------------------------------------------
# Không tiền tố. Tách bronze/silver/gold thay cho `analytics` gộp chung trước đây.
BRONZE_NAMESPACE=bronze
SILVER_NAMESPACE=silver
GOLD_NAMESPACE=gold

# ---- MinIO / S3 --------------------------------------------------------------
# PLACEHOLDER — thay bằng secret thật lúc deploy, đừng commit giá trị thật.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1
CATALOG_DB_PASSWORD=change-me

S3_ENDPOINT=http://minio:9000
MINIO_ENDPOINT=minio:9000
ICEBERG_REST_URI=http://iceberg-rest:8181

# ---- Trino -------------------------------------------------------------------
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=admin

# ---- Dữ liệu -----------------------------------------------------------------
LANDING_PREFIX=landing

# PROD chạy dữ liệu đầy đủ, không sample.
SAMPLE_ENABLED=false
