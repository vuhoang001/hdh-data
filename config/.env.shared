# =============================================================================
# CẤU HÌNH DÙNG CHUNG — giống hệt nhau ở mọi môi trường.
#
# Thứ tự nạp (Makefile + docker compose):
#     config/.env.shared      ← file này: version, đường dẫn, tên catalog
#     config/.env.<ENV>       ← dev hoặc prod: engine, endpoint, namespace
#     config/.env.local       ← tuỳ chọn, GITIGNORE: secret thật + override cá nhân
#
# Quy tắc: file này KHÔNG chứa secret và KHÔNG chứa thứ gì khác nhau giữa dev/prod.
# Nếu một giá trị cần khác nhau theo môi trường thì nó thuộc về .env.dev / .env.prod.
#
# LƯU Ý: Makefile include file này nên chỉ dùng cú pháp KEY=value đơn giản.
# Không dấu nháy, không ký tự '#' trong giá trị (Make hiểu là comment).
# =============================================================================

# ---- Phiên bản image / thư viện ---------------------------------------------
# PIN CHẶT. Lý do không dùng `latest`: (1) build tháng sau phải ra đúng image
# tháng này, (2) offline bundle không tái lập được nếu tag trôi.
# Trino và mc pin bằng DIGEST vì image không phát hành version tag ổn định.
ICEBERG_VERSION=1.9.2
POSTGRES_JDBC_VERSION=42.7.4
SPARK_BASE_IMAGE=apache/spark:3.5.6-python3
# hadoop-aws cho S3A: image Spark gốc KHÔNG có sẵn, mà không có nó Spark không đọc
# được file thô trên object storage (Iceberg dùng S3FileIO riêng, không thay thế được).
# PHẢI khớp Hadoop mà Spark đóng gói — apache/spark:3.5.6 dùng hadoop-client 3.3.4.
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262
PYYAML_VERSION=6.0.2

# dbt-core và adapter đánh version ĐỘC LẬP nhau nên khai riêng. Pin `==`.
DBT_CORE_VERSION=1.12.0
DBT_DUCKDB_VERSION=1.10.1
DBT_TRINO_VERSION=1.10.3

# duckdb: dbt-duckdb khai `duckdb>=1.0.0` (KHÔNG chặn trần) nên nếu không pin ở đây,
# một lần `pip install` trong tương lai sẽ kéo về version khác mà không ai biết.
# Cần >= 1.4.0 để GHI được Iceberg; 1.5.5 là bản đã kiểm chứng với stack này.
DUCKDB_VERSION=1.5.5
PYARROW_VERSION=18.1.0
BOTO3_VERSION=1.35.99

# Image pin bằng digest / release tag cụ thể
TRINO_IMAGE=trinodb/trino@sha256:90b35b7c603eaa1f889bf03981a62b75f998ee6c0f851d9f4e341b49a57022b6
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
POSTGRES_IMAGE=postgres:16-alpine

# ---- Iceberg catalog ---------------------------------------------------------
# MỘT catalog dùng chung cho cả dev lẫn prod. Tách môi trường bằng NAMESPACE
# (xem .env.dev / .env.prod), không tách bằng bucket — vì Iceberg REST catalog
# chỉ quản lý đúng một warehouse.
ICEBERG_CATALOG_NAME=iceberg
WAREHOUSE_BUCKET=warehouse
ICEBERG_REST_PORT=8181

# Postgres làm metastore cho Iceberg REST catalog (lưu namespace/bảng)
CATALOG_DB_NAME=iceberg
CATALOG_DB_USER=iceberg

# LƯU Ý: LANDING_PREFIX KHÔNG ở đây mà ở .env.dev / .env.prod — dev chạy dữ liệu
# sample nên phải có landing riêng, nếu không một lần `make landing` ở dev sẽ ghi đè
# mất dữ liệu đầy đủ của prod.

# ---- Cổng mở ra host ---------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Đường dẫn BÊN TRONG container ------------------------------------------
SPARK_DATA_DIR=/opt/spark/data
SPARK_JOBS_DIR=/opt/spark/jobs
SPARK_BRONZE_DIR=/opt/spark/bronze
DBT_PROJECT_DIR=/usr/app/dbt
DBT_DATA_DIR=/data
INGEST_JOBS_DIR=/opt/ingestion
