# =============================================================================
# MÔI TRƯỜNG DEV — DuckDB làm execution engine.
#
#   dbt ──► DuckDB ──► Iceberg ──► MinIO
#
# Khác PROD ĐÚNG ở: execution engine, namespace, và lượng dữ liệu.
# KHÔNG khác ở: model, business logic, data contract, test.
#
# Dùng:  make ENV=dev <target>      (ENV=dev là mặc định)
# =============================================================================

ENVIRONMENT=dev

# ---- Execution engine --------------------------------------------------------
# dbt target (profiles.yml) và engine chạy ingestion.
# DEV KHÔNG cần Spark: DuckDB đọc landing Parquet rồi chạy chính bronze_<bảng>.sql.
DBT_TARGET=dev
INGESTION_ENGINE=duckdb

# ---- Namespace theo tầng -----------------------------------------------------
# Tiền tố dev_ để dữ liệu dev và prod sống chung một catalog mà không đè nhau.
BRONZE_NAMESPACE=dev_bronze
SILVER_NAMESPACE=dev_silver
GOLD_NAMESPACE=dev_gold

# ---- MinIO / S3 --------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1
CATALOG_DB_PASSWORD=change-me

# S3_ENDPOINT có scheme (Spark/Trino/Iceberg dùng); MINIO_ENDPOINT không có scheme
# (DuckDB CREATE SECRET yêu cầu dạng host:port). Hai biến, một giá trị — cố ý.
S3_ENDPOINT=http://minio:9000
MINIO_ENDPOINT=minio:9000
ICEBERG_REST_URI=http://iceberg-rest:8181

# >>> CHẠY DuckDB NATIVE TRÊN LAPTOP (không qua Docker) <<<
# Hai biến trên trỏ vào tên service nội bộ của docker network. Khi chạy dbt/ingest
# thẳng trên máy, tạo config/.env.local với:
#     MINIO_ENDPOINT=localhost:9000
#     ICEBERG_REST_URI=http://localhost:8181
# Cổng 9000 và 8181 đã map sẵn ra host trong compose.base.yml.

# ---- DuckDB ------------------------------------------------------------------
# CHÚ Ý: file này KHÔNG phải kho dữ liệu. Toàn bộ dữ liệu nằm trên Iceberg/MinIO.
# Nó chỉ là database tạm để DuckDB có chỗ ATTACH catalog từ đó — xoá đi không mất gì.
DUCKDB_PATH=/tmp/dev_scratch.duckdb

# ---- Dữ liệu -----------------------------------------------------------------
# DEV chạy trên tập mẫu để nhanh. Sampling PHẢI cascade theo khoá ngoại, nếu không
# test relationships ở silver sẽ đỏ ở dev trong khi prod xanh — đúng loại lệch
# dev/prod mà refactor này đang xoá bỏ.
# Landing RIÊNG cho dev: dev ghi dữ liệu đã sample, prod ghi dữ liệu đầy đủ. Dùng
# chung prefix thì lần `make landing` nào cũng ghi đè lên môi trường kia.
LANDING_PREFIX=landing-dev

SAMPLE_ENABLED=true
SAMPLE_MONTHS=6
