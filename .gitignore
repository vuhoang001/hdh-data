# dbt (artifact sinh ra khi chạy, không commit)
dbt/target/
dbt/dbt_packages/
dbt/logs/

# pytest
.pytest_cache/

# duckdb (nếu chạy local ngoài container)
*.duckdb
*.duckdb.wal

# python
__pycache__/
*.pyc
.venv/
venv/

# local
.DS_Store

# Cấu hình: config/.env.{shared,dev,prod} ĐƯỢC commit — chúng chỉ chứa giá trị
# mặc định và placeholder, và là thứ khiến `git clone && make dev-up` chạy được.
# Secret thật đi qua config/.env.local (không commit) hoặc secret manager.
.env
.env.*
!.env.example
!config/.env.shared
!config/.env.dev
!config/.env.prod
!config/.env.local.example
config/.env.local
