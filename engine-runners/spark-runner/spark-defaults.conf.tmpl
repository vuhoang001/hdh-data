# =============================================================================
# TEMPLATE cấu hình Spark. Mọi ${VAR} được thay bằng biến môi trường (đến từ .env)
# lúc container khởi động — xem docker/images/spark-entrypoint.sh.
#
# Vì sao phải dùng template thay vì ghi ${env:VAR} thẳng vào file:
# Iceberg đọc các key spark.sql.catalog.* qua getAllConfs của Spark, đường này KHÔNG
# chạy qua bộ nội suy biến của SQLConf — nên ${env:...} sẽ tới Iceberg nguyên văn.
# Nội suy trước ở entrypoint là cách chắc chắn đúng.
#
# ĐỪNG hardcode endpoint/bucket ở đây. Sửa .env.
# =============================================================================

spark.sql.extensions   org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions

# ---- Catalog Iceberg qua REST, dữ liệu nằm trên MinIO (S3) ------------------
spark.sql.catalog.${ICEBERG_CATALOG_NAME}                       org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.${ICEBERG_CATALOG_NAME}.type                  rest
spark.sql.catalog.${ICEBERG_CATALOG_NAME}.uri                   ${ICEBERG_REST_URI}
spark.sql.catalog.${ICEBERG_CATALOG_NAME}.warehouse             s3://${WAREHOUSE_BUCKET}/
spark.sql.catalog.${ICEBERG_CATALOG_NAME}.io-impl               org.apache.iceberg.aws.s3.S3FileIO
spark.sql.catalog.${ICEBERG_CATALOG_NAME}.s3.endpoint           ${S3_ENDPOINT}
spark.sql.catalog.${ICEBERG_CATALOG_NAME}.s3.path-style-access  true

# ---- S3A: để Spark ĐỌC FILE THÔ trên MinIO (landing zone) -------------------
# Khác với khối trên: khối trên cấu hình Iceberg (S3FileIO) cho các BẢNG của catalog,
# khối này cấu hình Hadoop FileSystem cho spark.read.parquet("s3a://..."). Hai đường IO
# độc lập nhau — có cái này không suy ra có cái kia.
spark.hadoop.fs.s3a.impl                 org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.endpoint             ${S3_ENDPOINT}
spark.hadoop.fs.s3a.access.key           ${AWS_ACCESS_KEY_ID}
spark.hadoop.fs.s3a.secret.key           ${AWS_SECRET_ACCESS_KEY}
# MinIO không hỗ trợ virtual-host style (bucket.host), phải dùng path style
spark.hadoop.fs.s3a.path.style.access    true
spark.hadoop.fs.s3a.connection.ssl.enabled false

# Dùng iceberg làm catalog mặc định
spark.sql.defaultCatalog        ${ICEBERG_CATALOG_NAME}
spark.sql.catalogImplementation in-memory
